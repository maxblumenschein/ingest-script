#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

VENV_DIR="venv"

# First-time setup check (config.json, or a legacy user_config.py)
if [ ! -f "config.json" ] && [ ! -f "user_config.py" ]; then
    echo ""
    echo "  No user configuration found."
    echo "  Run once to set up:  python3 onboard.py"
    echo ""
    exit 1
fi

# Create virtual environment if it does not exist
if [ ! -d "$VENV_DIR" ]; then
    echo "  Creating virtual environment…"
    python3 -m venv "$VENV_DIR"
fi

# Call the venv's Python directly instead of `source venv/bin/activate`:
# activate (and the pip script) hardcode the absolute path the venv was
# created at, so they break once the folder is moved, renamed or copied.
PY="$VENV_DIR/bin/python"

"$PY" -m pip install --quiet --upgrade pip
"$PY" -m pip install --quiet -r _internal/requirements.txt

# process.py reads the paths from config.json and asks who is working
# (Enter = last user).
"$PY" "./_internal/process.py" "$@"
